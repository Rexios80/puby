#!/bin/sh
# Fast stand-in for the Flutter SDK. See test/test_utils.dart.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
. "$script_dir/common.sh"

case "${1:-}" in
  pub)
    handle_pub "$@"
    ;;
  test)
    echo "No tests were found." >&2
    exit 1
    ;;
  *)
    exit 0
    ;;
esac
