#!/bin/sh
# Fast stand-in for FVM. See test/test_utils.dart.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)

read_fvm_version() {
  dir=$(pwd)
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.fvmrc" ]; then
      sed -n 's/.*"flutter"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$dir/.fvmrc" | head -n 1
      return 0
    fi
    dir=$(dirname "$dir")
  done
}

if [ "${1:-}" = "--version" ]; then
  echo "3.2.1"
  exit 0
fi

version=$(read_fvm_version)
# Tests pin installed SDKs at 3.24.0. Anything else matches FVM's
# "not installed" prompt, which puby must turn into an install hint.
if [ "$version" != "3.24.0" ]; then
  echo "Flutter SDK: SDK Version : $version is not installed."
  exit 1
fi

tool=${1:?}
shift

if [ "$tool" = "flutter" ] && [ "${1:-}" = "--version" ]; then
  printf '{ "frameworkVersion": "%s" }\n' "$version"
  exit 0
fi

PUBY_STUB_FLUTTER_VERSION=$version
export PUBY_STUB_FLUTTER_VERSION
exec "$script_dir/$tool" "$@"
